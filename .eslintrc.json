{
  "env": {
    "browser": true,
    "es6": true,
    "node": true,
    "jest": true
  },
  "extends": "next/core-web-vitals",
  "rules": {
    "no-var": "error",
    "no-multiple-empty-lines": "error",
    "no-console": "off",
    "eqeqeq": "error",
    "dot-notation": "error",
    "no-unused-vars": "warn"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
